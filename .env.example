# Copy this file to ".env" and change what you need.
#   macOS/Linux:  cp .env.example .env
#   Windows:      copy .env.example .env
#
# .env is NOT committed to Git (see .gitignore). Real environment variables
# win over the values in this file.
# Where your expenses are stored. Relative paths start from the folder you
# run the app in; "~" means your home folder.
EXPENSE_TRACKER_DATA_DIR=data
# How much detail goes into data/logs/expense_tracker.log:
# DEBUG, INFO, WARNING, ERROR or CRITICAL
EXPENSE_TRACKER_LOG_LEVEL=INFO